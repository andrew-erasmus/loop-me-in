{
  "name": "date-calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "stop": "sh scripts/stop-dev.sh",
    "mobile": "npm start --workspace @date-calendar/mobile -- --port 8082",
    "mobile:ios": "npm start --workspace @date-calendar/mobile -- --ios --port 8082",
    "dev:api": "npm run dev --workspace @date-calendar/api",
    "dev:web": "npm run dev --workspace @date-calendar/web",
    "db:push": "npm run db:push --workspace @date-calendar/api",
    "seed": "npm run seed --workspace @date-calendar/api",
    "test": "npm run test --workspace @date-calendar/core",
    "typecheck": "tsc --build --force && npm run typecheck --workspace @date-calendar/mobile"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.25.76"
  }
}
