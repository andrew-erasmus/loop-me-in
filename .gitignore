node_modules/
dist/
# vite-plugin-pwa's development service worker, regenerated by `npm run dev`.
dev-dist/
*.db
*.db-journal
*.db-shm
*.db-wal
.DS_Store
*.local
.vercel

# TypeScript's incremental build cache. It is rewritten whenever a source file
# changes, so tracking it puts a whole-file diff of a build artifact into every
# commit that touches TypeScript — and makes a merge conflict out of two people
# having compiled.
*.tsbuildinfo

# Secrets: OAuth credentials, the session key, the Firebase key. No .env file
# is ever committed — OAUTH-AND-DEPLOYMENT.md lists what goes in them, and
# production's values live in each Vercel project's settings.
.env
.env.*
