# Staging API — a production-shaped environment you can break safely.
#
# Identical in shape to .env.production.example. The differences that matter:
# its own Google OAuth client, its own SESSION_SECRET, and its own database, so
# nothing you do here can touch the calendar you actually rely on.

NODE_ENV=production

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_SECRET=

WEB_ORIGIN=https://staging.calendar.example.com
OAUTH_CALLBACK_URL=https://staging-api.calendar.example.com/api/auth/google/callback

TURSO_DATABASE_URL=libsql://your-staging-db.turso.io
TURSO_AUTH_TOKEN=

COOKIE_SAMESITE=none

# --- Push notifications -------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private
# key. Paste the WHOLE downloaded JSON file here on one line (or base64 of it,
# if your host mangles quotes). This one IS secret: it can send notifications
# as your app. Unset means notifications are off, not an error.
# See PUSH-NOTIFICATIONS.md.
FIREBASE_SERVICE_ACCOUNT=
