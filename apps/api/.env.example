# Copy to `.env` and fill in. Everything here has a working default except the
# Google credentials, so an empty file is a valid development setup as long as
# AUTH_DEV_USER is set.

# --- Google sign-in -----------------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → Create OAuth client ID
# (type: Web application). Under "Authorised redirect URIs" add EXACTLY:
#
#   http://localhost:5173/api/auth/google/callback
#
# That points at Vite, not this API, because Vite proxies /api through to us —
# which keeps the whole sign-in flow on one origin so the session cookie is
# unambiguous. Add both of your email addresses as test users on the OAuth
# consent screen and leave it in Testing mode; that avoids Google's
# verification review entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sessions -----------------------------------------------------------------
# Signs the session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in development (a random one is generated each boot, which just means
# a restart signs you out). Required when NODE_ENV=production.
SESSION_SECRET=

# --- Local development only ---------------------------------------------------
# Skip Google entirely and sign every request in as this user. The seed creates
# alice@example.com and bob@example.com — point a second browser profile at Bob
# to see the app as two different people. Ignored when NODE_ENV=production.
AUTH_DEV_USER=alice@example.com

# --- Locations ----------------------------------------------------------------
# Where the web app lives. Sign-in returns the browser here, and invite links
# are built against it.
WEB_ORIGIN=http://localhost:5173

# Override if the callback cannot be derived from WEB_ORIGIN.
# OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# PORT=3031

# --- Database -------------------------------------------------------------
# Defaults to a local libSQL file at ./calendar.db — no Turso account needed
# for local work. Set these two only to point at a real Turso database (e.g.
# to run migrations against production from your laptop):
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
