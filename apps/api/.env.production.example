# Production API. Copy the KEYS into your host's environment-variable settings
# (Vercel project settings, Fly secrets, Railway variables) — do not deploy
# this file, and do not commit the filled-in version.
#
# Everything here is required. The API refuses to start in production without a
# SESSION_SECRET, and sign-in cannot work without the Google pair.

NODE_ENV=production

# --- Sign-in ------------------------------------------------------------------
# From the Google Cloud console. Use a SEPARATE OAuth client from the one you
# use locally, so rotating a leaked production secret cannot break your laptop
# and vice versa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AUTH_DEV_USER is deliberately absent. It is ignored when NODE_ENV=production,
# but leaving it out of the file means nobody can enable it by flipping one
# variable.

# --- Sessions -----------------------------------------------------------------
# Generate once and keep it stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs both of you out of every device. It must NOT be regenerated
# per deploy, which is why it is a stored secret rather than a build step.
SESSION_SECRET=

# --- Locations ----------------------------------------------------------------
# The deployed web app's origin, scheme included, no trailing slash. Sign-in
# returns the browser here and invite links are built against it, so a wrong
# value here is the single most likely cause of a broken login loop.
WEB_ORIGIN=https://calendar.example.com

# Only needed if the callback is not WEB_ORIGIN + /api/auth/google/callback —
# which it will not be once the API has its own domain rather than sitting
# behind the web app's proxy. Whatever you put here must be registered verbatim
# as an authorised redirect URI in the Google console.
OAUTH_CALLBACK_URL=https://api.calendar.example.com/api/auth/google/callback

# --- Cookies ------------------------------------------------------------------
# Set to `none` ONLY if the web app is served from a different domain than this
# API (e.g. calendar.example.com calling api.calendar.example.com). A `lax`
# cookie is never sent on cross-site requests, so the app would sign in and then
# act signed out. `none` requires HTTPS.
#
# Leave it unset if the API serves the web app itself, or sits behind the same
# domain — same-origin is simpler and strictly safer.
COOKIE_SAMESITE=none

# --- Database -----------------------------------------------------------------
# A Turso (hosted libSQL/SQLite) database — the only way SQLite works on a
# stateless host like Vercel, where there is no local disk that survives
# between requests. Create one with `turso db create`, then:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Running on a host with a real persistent volume instead (Fly, a VPS)? Set
# TURSO_DATABASE_URL to a local file path with the file: scheme instead, e.g.
# TURSO_DATABASE_URL=file:/data/calendar.db — and leave TURSO_AUTH_TOKEN unset.
# See OAUTH-AND-DEPLOYMENT.md for that recipe.

# Most hosts inject PORT themselves; set it only if yours does not.
# PORT=3031
