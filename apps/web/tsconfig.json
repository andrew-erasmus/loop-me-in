{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  // The service worker runs in a different global scope — `self` is a
  // ServiceWorkerGlobalScope, and there is no `document` — so it is checked by
  // tsconfig.sw.json against the WebWorker library instead of the DOM one.
  "exclude": ["src/sw.ts"]
}
