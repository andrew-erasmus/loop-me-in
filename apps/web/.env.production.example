# Web app, production build. Copy these KEYS into your host's build-time
# environment (Vercel/Netlify/Cloudflare project settings).
#
# Inlined into the JavaScript bundle — public by definition. No secrets.

# Point the browser at the deployed API. Must include the /api suffix, and the
# API's own WEB_ORIGIN must point back at wherever this build is served, or the
# session cookie will be rejected.
VITE_API_BASE_URL=https://api.calendar.example.com/api

# --- Push notifications -------------------------------------------------------
# From the Firebase console: Project settings → General → Your apps → the web
# app's config, plus Project settings → Cloud Messaging → Web Push certificates
# for the VAPID key. All public by design — Firebase identifies the project
# with these; it is the API's service-account key that is secret. Leave them
# unset and the Notifications page says notifications aren't set up.
# See PUSH-NOTIFICATIONS.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
